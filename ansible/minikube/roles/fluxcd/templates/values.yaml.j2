# FluxCD Helm values for resource-constrained environment
# Generated by Ansible - do not edit directly

installCRDs: true

logLevel: info
watchAllNamespaces: true

# Disable controllers we don't need
imageAutomationController:
  create: false

imageReflectionController:
  create: false

notificationController:
  create: false

sourceWatcher:
  create: false

# Source controller
sourceController:
  create: true
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 200m
      memory: 128Mi

# Kustomize controller
kustomizeController:
  create: true
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 300m
      memory: 128Mi

# Helm controller
helmController:
  create: true
  resources:
    requests:
      cpu: 50m
      memory: 64Mi
    limits:
      cpu: 300m
      memory: 128Mi
